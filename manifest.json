{
  "manifest_version": 2,
  "name": "Pacetyper",
  "version": "1.4.4",
  "description": "Types your text into a page at a human pace, with realistic pauses and corrections.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "tabs",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "browser_action": {
    "default_title": "Pacetyper",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pacetyper@extension",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "commands": {
    "stop-typing": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Stop typing immediately"
    }
  }
}
